# ===== サーバー =====
PORT=3000
# 外部から見たこのサーバーのURL（GoogleのリダイレクトURIとSquare Webhookの署名検証に使用）
BASE_URL=http://localhost:3000
# 管理画面のログインパスワード（ユーザー名は admin）
ADMIN_PASSWORD=change-me
# データ保存先
DATABASE_PATH=./data/app.db

# ===== Square =====
# Developer Dashboard > アプリ > Credentials のアクセストークン
SQUARE_ACCESS_TOKEN=
# production または sandbox
SQUARE_ENVIRONMENT=sandbox
# Webhook購読の Signature key（Webhookを使わない場合は空でOK）
SQUARE_WEBHOOK_SIGNATURE_KEY=
# 対象店舗を絞る場合はカンマ区切りでロケーションID（空なら全店舗）
SQUARE_LOCATION_IDS=

# ===== Google =====
# Google Cloud Console > APIとサービス > 認証情報 > OAuth クライアントID（ウェブアプリケーション）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 店舗カレンダーの既定値（会社アカウント内のカレンダーID。店舗ごとの割り当ては管理画面で設定）
# 例: xxxxxxxx@group.calendar.google.com / primary = 会社アカウントのメインカレンダー / 空 = 書き込まない
STORE_CALENDAR_ID=primary

# ===== 同期設定 =====
# 何日先までのシフトを同期するか
SYNC_DAYS_AHEAD=30
# 定期同期の間隔（分）。0で無効
SYNC_INTERVAL_MINUTES=15
# シフトにタイムゾーンが無い場合の既定値
DEFAULT_TIMEZONE=Asia/Tokyo
# 予定タイトルの接頭辞
EVENT_TITLE_PREFIX=【シフト】
